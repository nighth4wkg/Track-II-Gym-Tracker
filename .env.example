# Browser-safe configuration. Copy this file to .env.local and replace only
# the placeholders. Never put service-role keys or database passwords here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Public app configuration. Use your own values; do not commit .env.local.
NEXT_PUBLIC_TRACK_WEB_ORIGIN=https://YOUR_PROJECT.pages.dev
NEXT_PUBLIC_TRACK_RELEASES_URL=https://github.com/YOUR_ACCOUNT/Track-II-Gym-Tracker/releases/latest
NEXT_PUBLIC_TRACK_ISSUES_URL=https://github.com/YOUR_ACCOUNT/Track-II-Gym-Tracker/issues

# Supabase Edge Function CORS allowlist. Set this as a Supabase secret, not in
# the browser bundle. Separate multiple exact origins with commas.
# TRACK_ALLOWED_ORIGINS=https://YOUR_PROJECT.pages.dev
