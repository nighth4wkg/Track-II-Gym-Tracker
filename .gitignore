# Track public repository ignore rules.
# Keep source, configuration, migrations, tests, and CI reviewable; keep local
# credentials, generated bundles, and historical upload archives out of Git.

# Dependencies and package-manager caches
/node_modules/
/.pnpm-store/
/.pnp/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Local environment and credentials (never publish these)
.env*
!.env.example
/.github-cli/
/.openai/
/QA-TEST/

# Generated application/build output
/.next/
/.vinext/
/dist/
/out/
/app/dist/
/app/_sites-preview/
/.wrangler/
/.npm-review-cache/
/work/
/outputs/
/release-artifacts/
/excluded_from_project/
/_zip-inspect/
/coverage/
/test-results/
/playwright-report/
*.tsbuildinfo

# Cloudflare upload archives and local snapshots
/cloudflare/*.zip
*.zip
/backups/
*.mp4
*.mov
*.webm
/supabase/.temp/

# Tooling and OS noise
.DS_Store
Thumbs.db
*.pem
.vercel/
npm-debug.log*
/debug.log
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# TypeScript files generated by Next
next-env.d.ts
